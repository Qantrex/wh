            euro(own["value"]), euro(own["p25"]), euro(own["p75"]), own["n"], own["conf"]))
    print("%d matching ads online, %d with a market value; %d at least %d %% below it%s\n" % (
        head["matching"], head["valued"], len(shown) if not a.all else sum(
            1 for r in cands if r["score"] is not None and r["discount"] >= a.below), round(100 * a.below),
        "" if not a.all else " (showing all)"))
    plain = [r for r in shown if not market.odd(r)]
    odd = [r for r in shown if market.odd(r)]
    print(deal_table(plain, name, a.md) if plain else "No deals right now.")
    if odd:
        print("\nFar below value without a reason given (more than %d %%): a real bargain, or a part, a defect the "
              "title doesn't say, the wrong model or a scam. Read the ad first.\n" % round(100 * market.TOO_GOOD))
        print(deal_table(odd, name, a.md))
    for r in shown:
        if r.get("flags"):
            log("  %s %s: %s" % (euro(r["price"]), cell(r["title"], 40), "; ".join(r["flags"])))


def cmd_value(a):
    c = db()
    target = " ".join(a.words)
    try:
        i = ad_id(target) if re.search(r"willhaben|adId=|^\s*\d{6,}\s*$", target) else None
    except WhError:
        i = None
    price = a.price
    if i:
        d = details(c, i)
        row = c.execute("select * from ads where id=?", (i,)).fetchone()
        ad = dict(row) if row else dict(id=i, title=d.get("title"), price=d.get("price"), cats="", body="")
        ad.update(descr=d.get("descr"), info=d.get("info") or [], price=d.get("price") or ad.get("price"))
        name = a.kind or market.kind_of(ad)
        if not name:
            raise WhError("ad %d is not in a category wh values (%s); pass --kind" % (i, ", ".join(sorted(market.KINDS))))
        market.specs(ad, name)
        if ad["junk"]:
            log("note: as an item of this kind, the ad looks like junk: %s" % ad["junk"])
        want, label, exclude = ad["specs"], ad["title"], i
        price = price if price is not None else ad.get("price")
    else:
        name, want, _ = resolve(a, target)
        label, exclude = target, None
    if not a.no_crawl:
        crawl(c, [name])
    rows = kind_rows(c, name)
    idx = market.build_index(rows, name)
    by_id = {r["id"]: r for r in rows}
    levels = []
    for lvl, key in market.keys(name, want):
        est = market.estimate(idx.get((lvl, key), []), exclude)
        if est:
            est.update(level=market.KINDS[name]["keys"][lvl], key=key)
            levels.append(est)
    best = market.value_of(idx, name, want, exclude)
    out = dict(item=label, kind=name, specs=market.label(name, want), price=price,
               value=best and {k: best[k] for k in ("value", "p25", "p75", "n", "conf", "spread")},
               discount=round(1 - price / best["value"], 3) if best and price else None,
               levels=[dict(key=" · ".join(str(x) for x in e["key"] if x != "-"), value=e["value"], p25=e["p25"],
                            p75=e["p75"], n=e["n"], conf=e["conf"]) for e in levels],
               comps=comps_for(idx, by_id, name, best, exclude))
    if a.json:
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return
    print("%s → %s: %s" % (label, name, out["specs"] or "?"))
    if not best:
        print("No market value: fewer than %d sellers with the same item in the last %d days." % (
            market.MIN_SELLERS, market.VALUE_DAYS))
        return
    print("Market value %s (middle half %s–%s, %d sellers, %s confidence)" % (
        euro(best["value"]), euro(best["p25"]), euro(best["p75"]), best["n"], best["conf"]))
    if price:
        print("Price %s is %s against it" % (euro(price), pct(out["discount"])))
    print("\nBy how exactly the item matches (most exact first):")
    for e in out["levels"]:
        print("  %-48s %8s  (%s–%s, %d sellers, %s)" % (cell(e["key"], 48), euro(e["value"]), euro(e["p25"]),
                                                       euro(e["p75"]), e["n"], e["conf"]))
    print("\nAds behind it:")
    for x in out["comps"]:
        print("  %7s  %s  (seen %s)\n           %s" % (euro(x["price"]), cell(x["title"], 60), x["last_seen"], x["url"]))


def cmd_crawl(a):
    c = db()
    kinds = a.kinds or sorted(market.KINDS)
    bad = [k for k in kinds if k not in market.KINDS]
    if bad:
        raise WhError("unknown kind %s; known: %s" % (", ".join(bad), ", ".join(sorted(market.KINDS))))
    if a.list:
