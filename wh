    for f, _, p in todo:
        note_for(p, f)
    plans, ok, report = [], [], []
    for note in todo:                                       # before this run records anything
        try:
            plans.append(sweep_plan(c, note[0], note[2]))
            ok.append(note)
        except WhError as e:                                # e.g. a typo in wh-area: skip this note only
            report.append(dict(note=name_of(note[0]), path=note[0], error=str(e)))
