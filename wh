def area(spec):
    """`wien, noe` (or a list) → {'Wien', 'Niederösterreich'}; empty without an area."""
    words = [w for x in (spec if isinstance(spec, list) else [spec or ""]) for w in re.split(r"[,;/\s]+", x.lower()) if w]
    out = set()
    for w in words:
        st = next((s for s, names in STATES.items() if w in names[1:]), None)
        if not st:
            raise WhError("unknown area %r; use %s" % (w, ", ".join(n[1] for n in STATES.values())))
        out.add(st)
    return out


def area_label(states):
    return "/".join(short for s, (short, *_) in STATES.items() if s in states)


def mark_near(ads, states):
    """Mark the ads in my pickup area. Only a mark: ads elsewhere stay, since I can travel there or ask for shipping."""
    for a in ads:
        a["near"] = (a.get("state") in states) if states else None
    return ads


