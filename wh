import profiles  # noqa: E402

BASE = "https://www.willhaben.at"
SEARCH = BASE + "/iad/kaufen-und-verkaufen/marktplatz"
UA = "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"
DB = os.path.expanduser(os.environ.get("WH_DB", "~/.local/share/wh/wh.db"))
NOTES = os.path.expanduser(os.environ.get("WH_NOTES", "~/Notes/Marketplace"))
SKILL = os.path.expanduser(os.environ.get("WH_SKILL", "~/.claude/skills/willhaben/SKILL.md"))
