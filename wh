# ---- market value: crawl, find, value, watch -----------------------------------------------------------------

FULL_CRAWL_H = 20                                          # a category's full crawl counts as fresh this long


def crawl_key(path):
    return "crawl:" + path


def last_full_crawl(c, path):
    r = c.execute("select max(at) a from runs where key=? and complete=1", (crawl_key(path),)).fetchone()
    return r["a"] if r else None


def record_crawl(c, url, path, found, complete, t):
    c.execute("insert into runs (key, url, at, found, complete) values (?,?,?,?,?)",
              (crawl_key(path), url, t, found, int(complete)))


def crawl_new(c, paths, max_pages=10):
    """Read each category from its newest ads until a page has nothing new or changed (at most max_pages pages).
    Categories run side by side, pages within one one after the other. Returns {path: (found, ads read)}."""
    known = {}
    for p in paths:
        cid = re.search(r"(\d+)$", p).group(1)
        known[p] = {r["id"]: r["price"] for r in c.execute("select id, price from ads where cats like ?",
                                                            ("%" + cid + "%",))}

    def one(p):
        url, got, found = search_url(url=p), [], 0
        for page in range(1, max_pages + 1):
            r = read_page("%s&page=%d" % (url, page))
            if not isinstance(r, tuple):
                break
            found, ads = r
            got += ads
            if not any(known[p].get(a["id"], -1) != a["price"] for a in ads) or page * 200 >= found:
                break
        return found, got
    t = now()
    out = {}
    for p, r in zip(paths, pmap(one, paths)):
        if isinstance(r, FetchError):
            log("  %s: %s" % (p, r))
            continue
        store(c, r[1], t)
        record_crawl(c, search_url(url=p), p, r[0], False, t)
        out[p] = r
        log("  %s: %d new or changed of %d read" % (p.rsplit("/", 1)[-1], sum(
            1 for a in r[1] if known[p].get(a["id"], -1) != a["price"]), len(r[1])))
    c.commit()
    return out


def crawl(c, kinds, full=None, max_pages=400):
    """Bring the database up to date for these kinds: a full crawl of every category whose last full crawl is older
    than FULL_CRAWL_H hours (or all of them with full=True), only the new ads of the others (none with full=False)."""
    paths = list(dict.fromkeys(p for k in kinds for p in market.KINDS[k]["cats"]))
    whole, fresh = [], []
    for p in paths:
        last = last_full_crawl(c, p)
        stale = full is True or (full is None and (not last or hours_since(last) > FULL_CRAWL_H))
        (whole if stale else fresh).append(p)
    if whole:
        log("full crawl of %d categor%s (once a day; about 1 s per 1000 ads):" % (len(whole), "y" if len(whole) == 1 else "ies"))
        t = now()
        res = run_searches(c, [(search_url(url=p), None) for p in whole], max_pages, record=False)
        for p, r in zip(whole, res):
            record_crawl(c, search_url(url=p), p, r["found"], r["complete"], t)
        c.commit()
    if fresh:
        log("new ads in %d categor%s:" % (len(fresh), "y" if len(fresh) == 1 else "ies"))
        crawl_new(c, fresh)


def online_since(c, name):
    """Ads seen at or after this time are taken as still online: the oldest of the kind's last full crawls."""
    ts = [last_full_crawl(c, p) for p in market.KINDS[name]["cats"]]
    return min(ts) if ts and all(ts) else None


_ROWS = {}                                                 # kind -> annotated rows, for one run (watch run)
SPEC_VER = ""


def spec_sig(r):
    """What an ad's specs depend on: its text, filters and whether it has a price, plus the extractor code itself
    (market.py and profiles.py), so a changed extractor recomputes every ad."""
    global SPEC_VER
    if not SPEC_VER:
        h = hashlib.sha1()
        for mod in (market, profiles):
            with open(mod.__file__, "rb") as f:
                h.update(f.read())
        SPEC_VER = h.hexdigest()[:12]
    raw = json.dumps([r.get("title"), r.get("body"), r.get("descr"), r.get("info"), r.get("tattrs"), bool(r.get("price")),
                      r.get("cats"), r.get("private"), SPEC_VER], ensure_ascii=False)
    return hashlib.sha1(raw.encode()).hexdigest()[:16]


def kind_rows(c, name, days=market.VALUE_DAYS, cache=False):
    """Every ad of a kind seen in the last `days` days, annotated with its specs (market.specs). cache=True keeps
    them for the rest of the run (several watches of one kind); copies go out, so callers may change them."""
    if cache and name in _ROWS:
        return [dict(r) for r in _ROWS[name]]
    k = market.KINDS[name]
    since = datetime.fromtimestamp(time.time() - days * 86400, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    rows = [dict(r) for r in c.execute("select * from ads where last_seen >= ? and (%s)" % " or ".join(
        "cats like ?" for _ in k["ids"]), [since] + ["%" + i + "%" for i in k["ids"]])]
    rows = attach_details(c, [r for r in rows if market.in_cats(r, k["ids"])])
    known = {r["id"]: (r["sig"], r["data"]) for r in c.execute("select id, sig, data from specs where kind=?", (name,))}
    todo = []
    for r in rows:                                          # specs are cached per ad until the ad or the code changes
        sig = spec_sig(r)
        hit = known.get(r["id"])
        if hit and hit[0] == sig:
            r.update(json.loads(hit[1]))
        else:
            market.specs(r, name)
            todo.append((r["id"], name, sig, json.dumps({k: r[k] for k in ("junk", "specs", "cond")}, ensure_ascii=False)))
    if todo:
        c.executemany("insert or replace into specs values (?,?,?,?)", todo)
        c.commit()
    if cache:
        _ROWS[name] = [dict(r) for r in rows]
    return rows


def comps_for(idx, rows_by_id, name, est, exclude):
    """Up to 5 ads behind a market value, the ones nearest the value first."""
    if not est:
        return []
    lvl = market.KINDS[name]["keys"].index(est["level"])
    ids = {i for _, _, _, i in idx.get((lvl, est["key"]), []) if i != exclude}
    ads = sorted((rows_by_id[i] for i in ids if i in rows_by_id), key=lambda a: abs(a["price"] - est["value"]))
    return [dict(id=a["id"], title=a["title"], price=a["price"], url=a["url"], last_seen=(a.get("last_seen") or "")[:10])
            for a in ads[:5]]


def seller_flags(d):
    flags = []
    since = d.get("seller_since") or ""
    if re.fullmatch(r"\d{4}-\d{2}", since):
        y, m = map(int, since.split("-"))
        t = date.today()
        if (t.year - y) * 12 + t.month - m <= 2:
            flags.append("seller joined %s" % since)
    if not d.get("images"):
        flags.append("no photos")
    return flags


def find_deals(c, name, want, size=None, pmin=None, pmax=None, states=(), details_n=8, only=None, cache=False):
    """Online ads of a kind that match `want` (market.matches), each with its market value, discount and the ads
    behind the value, best deal first. The top `details_n` get their full ad checked (status, description, seller).
    `only`: a set of ad ids to limit the candidates to (watch: new or cheaper since last time)."""
    rows = kind_rows(c, name, cache=cache)
    idx = market.build_index(rows, name)
    by_id = {r["id"]: r for r in rows}
    cut = online_since(c, name)
    cands = []
    for r in rows:
        if r["junk"] or not r.get("price") or (cut and (r.get("last_seen") or "") < cut):
            continue
        if not cut and hours_since(r["last_seen"]) > 30:
            continue
        if (pmin is not None and r["price"] < pmin) or (pmax is not None and r["price"] > pmax):
            continue
        if only is not None and r["id"] not in only:
            continue
        if market.matches(r["specs"], want, size):
            cands.append(r)

    def rate(r):
        est = market.value_of(idx, name, r["specs"], exclude=r["id"])
        r.update(market.deal(r, est))
        r["est"] = est
    for r in cands:
        rate(r)
    rank = lambda r: (r["score"] is None, market.odd(r),   # noqa: E731
                      -(r["score"] or 0), r["price"])          # unexplained "too good to be true" after the plain deals
    cands.sort(key=rank)
    if details_n:
        top = [r for r in cands if r["score"] is not None][:details_n]
        got = details_many(c, [r["id"] for r in top])
        for r in top:
            d = got.get(r["id"])
            if isinstance(d, FetchError) or d is None:
                continue
            if d["status"] != "active":
                r["junk"] = "ad is %s" % d["status"]
                continue
            r.update(descr=d["descr"], info=d.get("info") or [], seller_name=d.get("seller"),
                     seller_since=d.get("seller_since"), seller_ads=d.get("seller_ads"),
                     first_published=d.get("first_published"), photos=len(d.get("images") or []),
                     price=d["price"] if d.get("price") else r["price"])
            before = dict(r["specs"])
            market.specs(r, name)                          # again, now with the full description
            if not r["junk"] and not market.matches(r["specs"], want, size):
                r["junk"] = "full ad doesn't match (%s)" % market.label(name, r["specs"])
            if r["junk"]:
                continue
            if r["specs"] != before:
                rate(r)
            r["flags"] = r.get("flags", []) + seller_flags(d)
            r["checked"] = True
        cands = [r for r in cands if not r["junk"]]
        cands.sort(key=rank)
    mark_near(cands, set(states or ()))
    for r in cands:
        r["comps"] = comps_for(idx, by_id, name, r.get("est"), r["id"])
    return cands, rows, idx


def deal_json(r, name):
    est = r.get("est") or {}
    d = {k: r.get(k) for k in ("id", "title", "price", "loc", "state", "url", "published", "cond", "value", "discount",
                               "score", "flags", "urgent", "comps")}
    d.update(private=bool(r.get("private")), ships=market.ships(r), specs=market.label(name, r["specs"]),
             conf=est.get("conf"), value_from=dict(n=est.get("n"), p25=est.get("p25"), p75=est.get("p75"),
                                                   key=" · ".join(str(x) for x in est.get("key", ()) if x != "-"))
             if est else None)
    if r.get("near") is not None:
        d["near"] = r["near"]
    if r.get("checked"):
        d.update(checked=True, seller=r.get("seller_name"), seller_since=r.get("seller_since"),
                 seller_ads=r.get("seller_ads"), photos=r.get("photos"), online_since=r.get("first_published"),
                 description=cell(r.get("descr"), 1500))
    return d


def pct(x):
    return "" if x is None else "%+d %%" % round(-100 * x)


def deal_table(rows, name, md=False):
    head = ["Price", "Value", "vs value", "Conf", "Ad", "Where", "P/D", "Cond", "Specs"]
    has_near = any(r.get("near") is not None for r in rows)
    if has_near:
        head.insert(6, "Near")
    out = []
    for r in rows:
        cols = [euro(r["price"]), euro(r.get("value")), pct(r.get("discount")), (r.get("est") or {}).get("conf") or "",
                ("[%s](%s)" % (link_text(r["title"], 60), r["url"])) if md else r["title"], r.get("loc") or "",
                "P" if r.get("private") else "D", r.get("cond") or "", market.label(name, r["specs"])]
        if has_near:
            cols.insert(6, "✓" if r.get("near") else "")
        if r.get("urgent"):
            cols[4] = "⏱ " + cols[4]
        elif r.get("flags") and any("far below" in f or "joined" in f for f in r["flags"]):
            cols[4] = "⚠ " + cols[4]
        out.append(cols)
    if md:
        return "\n".join(["| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
                         + ["| " + " | ".join(cell(x) for x in r) + " |" for r in out])
    widths = [7, 7, 8, 6, 50, 20] + ([4] if has_near else []) + [3, 9, 40]
    fmt = lambda r: "  ".join(cell(x, w).ljust(w) for x, w in zip(r, widths)).rstrip()  # noqa: E731
    return "\n".join([fmt(head)] + [fmt(r) + "\n    " + x["url"] for r, x in zip(out, rows)])


def resolve(a, query):
    """(kind, wanted specs, size range) for a query and the --kind/--size options."""
    name = a.kind or market.guess_kind(query)
    if not name:
        raise WhError("can't tell what kind of item %r is; pass --kind (%s)" % (query, ", ".join(sorted(market.KINDS))))
    want = market.query_specs(query, name)
    size = None
    if name in ("tv", "monitor"):                       # a size in a find is a range: 45-55, or 55 → 55-55
        size = market.size_range(a.size or query) if (a.size or market.size_range(query)) else None
        one = want.pop("size", None)
        size = size or ((one, one) if one else None)
    return name, want, size


def cmd_find(a):
    c = db()
    query = " ".join(a.words)
    name, want, size = resolve(a, query)
    if not a.no_crawl:
        crawl(c, [name])
