FM = re.compile(r"\A---[ \t]*\r?\n(.*?)^---[ \t]*(?:\r?\n|\Z)", re.S | re.M)   # also empty, or at the end


def clean_val(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        return v[1:-1]
    if not v.startswith(("http://", "https://")):
        v = re.sub(r"\s+#.*$", "", v).strip()
    return [] if v == "[]" else v


def read_note(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    props, key, m = {}, None, FM.match(text)
    for line in (m.group(1).splitlines() if m else []):
        if line.strip().startswith("#"):
            continue
        if re.match(r"^\s+-\s", line) and key:
            v = clean_val(line.split("-", 1)[1])
            cur = props.get(key)
            props[key] = (cur if isinstance(cur, list) else ([cur] if cur else [])) + [v]
        elif ":" in line and not line.startswith((" ", "\t")):
            key, _, v = line.partition(":")
            key = key.strip()
            props[key] = clean_val(v)
    return text, props


def set_prop(text, key, value):
    m = FM.match(text)
    if not m:
        return "---\n%s: %s\n---\n" % (key, value) + text
    fm = m.group(1).rstrip("\r\n")
    repl = "%s: %s" % (key, value)
    if re.search(r"^%s:.*$" % re.escape(key), fm, re.M):
        fm = re.sub(r"^%s:.*$" % re.escape(key), lambda _: repl, fm, count=1, flags=re.M)
    else:
        fm += ("\n" if fm else "") + repl
    return "---\n" + fm + "\n---\n" + text[m.end():]


def put_block(text, name, content):
    """Replace (or append) the generated block <!-- wh:name --> … <!-- /wh:name --> in a note."""
    start, end = "<!-- wh:%s -->" % name, "<!-- /wh:%s -->" % name
    block = "%s\n%s\n%s" % (start, content.strip(), end)
    i = text.find(start)
    j = text.find(end, i) if i >= 0 else -1                  # the end marker after the start, not a stray one before
    if j >= 0:
        return text[:i] + block + text[j + len(end):]
    return text.rstrip() + "\n\n" + block + "\n"


def strip_blocks(text):
    return re.sub(r"<!-- wh:(\w+) -->.*?<!-- /wh:\1 -->\n?", "", text, flags=re.S)


def md_files(root):
    """The notes under a folder, skipping hidden folders: Obsidian's .trash holds deleted notes, .obsidian settings."""
    for d, dirs, fs in os.walk(root):
        dirs[:] = [x for x in dirs if not x.startswith(".")]
        yield from (os.path.join(d, f) for f in fs if f.endswith(".md") and not f.startswith("."))


def find_notes(args, types=None, statuses=None):
    files = []
    for p in args or [NOTES]:
        p = os.path.expanduser(p)
        if os.path.isdir(p):
            files += md_files(p)
        elif os.path.isfile(p):
            files.append(p)
        else:                                               # a note name, found under NOTES
            want = p.lower().removesuffix(".md")
            hits = [f for f in md_files(NOTES) if os.path.basename(f)[:-3].lower() == want]
            if not hits:
                sys.exit("wh: no note %r under %s" % (p, NOTES))
            files += hits
    out = []
    for f in sorted(set(files)):
        try:
            text, props = read_note(f)
        except (OSError, UnicodeDecodeError) as e:
            log("wh: skipped %s: %s" % (f, e))
            continue
        if (types and props.get("type") not in types) or (statuses and props.get("status") not in statuses):
            continue
        out.append((f, text, props))
    return out


def write_note(path, text):
    text = set_prop(text, "updated", date.today().isoformat())
    path = os.path.realpath(path)                           # a symlinked note stays a link, its target gets the text
    d = os.path.dirname(path)
    mode = os.stat(path).st_mode if os.path.exists(path) else None
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".wh-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.remove(tmp)
        raise


def update_note(path, change):
    """Write change(text) into a note, reading the note again first: an edit made in the editor while wh was
    fetching or Claude was thinking stays, since wh only touches its own properties and blocks."""
    with open(path, encoding="utf-8") as f:
        text = f.read()
    write_note(path, change(text))


def name_of(path):
    return os.path.basename(path)[:-3]


