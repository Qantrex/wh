WATCHES = os.path.join(os.path.dirname(CONFIG_PATH), "watches.toml")
WATCH_KEYS = {"name", "query", "kind", "size", "min", "max", "below", "conf", "area", "for"}


def load_watches(path=None):
    path = path or WATCHES
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        return []
    except tomllib.TOMLDecodeError as e:
        raise WhError("%s: %s" % (path, e))
    out = []
    for w in data.get("watch", []):
        bad = set(w) - WATCH_KEYS
        if bad or not w.get("name") or "query" not in w:
            raise WhError("%s: each [[watch]] needs `name` and `query`%s" % (
                path, "; unknown keys: %s" % ", ".join(sorted(bad)) if bad else ""))
        if w.get("kind") and w["kind"] not in market.KINDS:
            raise WhError("%s: watch %s: unknown kind %r" % (path, w["name"], w["kind"]))
        out.append(w)
    return out


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    return json.dumps(str(v), ensure_ascii=False)


def save_watches(ws, path=None):
    path = path or WATCHES
    os.makedirs(os.path.dirname(path), exist_ok=True)
    text = "# wh watches: saved `wh find` searches; `wh watch run` reports new deals once (wh watch add/rm edit this)\n"
    for w in ws:
        text += "\n[[watch]]\n" + "".join("%s = %s\n" % (k, toml_value(w[k])) for k in
                                          ("name", "query", "kind", "size", "min", "max", "below", "conf", "area", "for")
                                          if k == "query" or w.get(k) not in (None, ""))
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".wh-", suffix=".tmp")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def first_full_crawl(c, name):
    """When every category of a kind had been crawled in full once: ads first seen up to then are the starting
    stock, not new ads."""
    ts = []
    for p in market.KINDS[name]["cats"]:
        r = c.execute("select min(at) a from runs where key=? and complete=1", (crawl_key(p),)).fetchone()
        ts.append(r["a"] if r else None)
    return max(ts) if ts and all(ts) else None


def changed_since(c, watch, name):
    """(time, strict): a watch reports what's new or cheaper since its last run (ads seen at that second count, the
    alerts table keeps them from coming twice); the first run looks back a day, never into the kind's first full
    crawl."""
    r = c.execute("select at from watch_runs where watch=?", (watch,)).fetchone()
    since = r["at"] if r else datetime.fromtimestamp(time.time() - 86400, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    base = first_full_crawl(c, name)
    return (base, True) if base and base >= since else (since, False)   # strict: the first crawl's own ads are stock


def run_watch(c, w, details_n, record=True):
    """New deals for one watch: matching ads at least `below` under value with at least `conf` confidence that
    weren't reported yet (or are cheaper now than when they were)."""
    q = argparse.Namespace(kind=w.get("kind"), size=w.get("size"))
    name, want, size = resolve(q, w["query"])
    below = float(w.get("below", 0.25))
    order = ["low", "medium", "high"]
    min_conf = order.index(w.get("conf", "medium"))
    t0 = now()
    since, strict = changed_since(c, w["name"], name)
    rows = kind_rows(c, name, cache=True)
    new = {r["id"] for r in rows if (r.get("first_seen") or "") > since or (not strict and r.get("first_seen") == since)}
    before = last_prices(c, [r["id"] for r in rows if r["id"] not in new], since)
    cheaper = {r["id"] for r in rows if r["id"] in before and before[r["id"]] and r.get("price")
               and r["price"] < before[r["id"]]}
    cands, rows, idx = find_deals(c, name, want, size, w.get("min"), w.get("max"), area(w.get("area")), 0,
                                  only=new | cheaper, cache=True)
    seen = {r["id"]: r["price"] for r in c.execute("select id, price from alerts where watch=?", (w["name"],))}
    fresh = [r for r in cands if r["score"] is not None and r["discount"] >= below
             and order.index(r["est"]["conf"]) >= min_conf and (r["id"] not in seen or r["price"] < seen[r["id"]])]
    if fresh and details_n:                                 # check the full ads of only these
        cands, rows, idx = find_deals(c, name, want, size, w.get("min"), w.get("max"), area(w.get("area")),
                                      details_n, only={r["id"] for r in fresh}, cache=True)
        fresh = [r for r in cands if r["score"] is not None and r["discount"] >= below
                 and order.index(r["est"]["conf"]) >= min_conf]
    own = market.value_of(idx, name, want) if want else None
    if record:
        c.executemany("insert or replace into alerts values (?,?,?,?)", [(w["name"], r["id"], r["price"], t0) for r in fresh])
        c.execute("insert or replace into watch_runs values (?,?)", (w["name"], t0))
        c.commit()
    return dict(name=w["name"], query=w["query"], kind=name, wants=market.label(name, want) or "any",
                below=below, **{"for": w.get("for") or "me"},
                market=dict(value=own["value"], n=own["n"], conf=own["conf"]) if own else None,
                deals=[deal_json(r, name) for r in fresh])


def cmd_watch(a):
    ws = load_watches()
    if a.action == "list":
        if not ws:
            print("No watches yet (%s). Add one: wh watch add ram-32 \"2x16gb ddr4 3200\" --max 90" % WATCHES)
        for w in ws:
            print("%-16s %-32s %s" % (w["name"], w["query"], " ".join("%s=%s" % (k, w[k]) for k in
                                                                  ("kind", "size", "min", "max", "below", "conf", "area",
                                                                   "for") if w.get(k) not in (None, ""))))
        return
    if a.action == "add":
        if not a.args or (len(a.args) < 2 and not a.kind):
            raise WhError("usage: wh watch add NAME \"QUERY\" [--kind K] [--size 45-55] [--max N] [--below 0.25]; "
                          "with --kind the query may be left out (every ad of that kind)")
        w = dict(name=a.args[0], query=" ".join(a.args[1:]), kind=a.kind, size=a.size, min=a.min, max=a.max,
                 below=a.below, conf=a.conf, area=a.area, **{"for": a.for_})
        resolve(argparse.Namespace(kind=a.kind, size=a.size), w["query"])     # fails now rather than at run time
        save_watches([x for x in ws if x["name"] != w["name"]] + [w])
        print("watch %s saved in %s" % (w["name"], WATCHES))
        return
    if a.action == "rm":
        names = set(a.args or [])
        if not names & {w["name"] for w in ws}:
            raise WhError("no watch named %s" % ", ".join(sorted(names)))
        save_watches([w for w in ws if w["name"] not in names])
        return
    todo = [w for w in ws if not a.args or w["name"] in a.args]
    if not todo:
        raise WhError("no watches to run (%s)" % WATCHES)
    c = db()
    kinds = []
    for w in todo:
        kinds.append(resolve(argparse.Namespace(kind=w.get("kind"), size=w.get("size")), w["query"])[0])
    if not a.no_crawl:
        crawl(c, list(dict.fromkeys(kinds)))
    results, errors = [], []
    for w in todo:
        try:
            results.append(run_watch(c, w, a.details, record=not a.dry_run))
        except WhError as e:
            errors.append(dict(name=w["name"], error=str(e)))
    if a.json:
        print(json.dumps(dict(at=now(), dry_run=bool(a.dry_run), watches=results, errors=errors), ensure_ascii=False,
                         indent=1))
        return
    for r in results:
        mk = r["market"]
        print("## %s: %s (%s)%s" % (r["name"], r["query"], r["wants"], " · market %s, %d sellers, %s" % (
            euro(mk["value"]), mk["n"], mk["conf"]) if mk else ""))
        if not r["deals"]:
            print("No new deals.\n")
            continue
        for d in r["deals"]:
            print("- %s (value %s, %s, %s) %s · %s\n  %s%s" % (euro(d["price"]), euro(d["value"]), pct(d["discount"]),
                                                             d["conf"], d["title"], d["loc"], d["url"],
                                                             ("\n  ⚠ " + "; ".join(d["flags"])) if d["flags"] else ""))
        print()
    for e in errors:
        print("%s: %s" % (e["name"], e["error"]))


def doctor_checks():
    """(level, area, message) for everything wh depends on; level is ok, info, warn or FAIL. Sends no request."""
    home = os.path.expanduser("~")
    short = lambda p: p.replace(home, "~", 1) if p else p  # noqa: E731
    out = []
    add = lambda level, what, msg: out.append((level, what, msg))  # noqa: E731

    if os.path.isfile(CONFIG_PATH):
        add("ok", "config", "%s (%s)" % (short(CONFIG_PATH), ", ".join(sorted(CONFIG)) or "empty"))
        for k in sorted(set(CONFIG) - CONFIG_KEYS):
            add("warn", "config", "unknown key %r (known: %s)" % (k, ", ".join(sorted(CONFIG_KEYS))))
    else:
        add("info", "config", "no %s, using the defaults" % short(CONFIG_PATH))

    if not os.path.isdir(NOTES):
        add("FAIL", "notes", "no folder %s: set `notes` in the config or WH_NOTES" % short(NOTES))
    else:
        notes = find_notes([NOTES])
        buy = [(f, p) for f, _, p in notes if p.get("type") in ("buy", "wanted") and p.get("status") in OPEN]
        sell = [(f, p) for f, _, p in notes if p.get("type") == "sell" and p.get("status") in OPEN | {"draft"}]
        add("ok", "notes", "%s: %d notes, %d open buy/wanted (%d with `search:`), %d live sell" % (
            short(NOTES), len(notes), len(buy), sum(1 for _, p in buy if p.get("search")), len(sell)))
        for f, p in buy:
            if not p.get("for"):
                add("warn", "notes", "%s has no `for:`" % name_of(f))
            name = p.get("wh-profile")
            if name and name not in profiles.PROFILES:
                add("warn", "notes", "%s: unknown wh-profile %r" % (name_of(f), name))
            try:
                area(p.get("wh-area"))
            except WhError as e:
                add("warn", "notes", "%s: %s" % (name_of(f), e))
        for f, p in sell:
            if p.get("ad"):
                try:
                    ad_id(p["ad"])
                except WhError as e:
                    add("warn", "notes", "%s: %s" % (name_of(f), e))

    path = skill_path()
    configured = os.path.join(SKILL, "SKILL.md") if os.path.isdir(SKILL) else SKILL
    if not os.path.isfile(configured) and path == SHIPPED_SKILL:
        add("warn", "skill", "%s not found, the AI commands use the repo's copy; for Claude Code: ln -sfn %s %s" % (
            short(SKILL), short(os.path.dirname(SHIPPED_SKILL)), short(os.path.dirname(SKILL))))
    elif not os.path.isfile(path):
        add("FAIL", "skill", "no %s and no copy next to wh: the AI commands run without rules" % short(path))
    else:
        d = os.path.dirname(path)
        link = os.path.islink(d) and os.path.realpath(d) == os.path.dirname(SHIPPED_SKILL)
        add("ok", "skill", "%s%s" % (short(path), " (links to this repo)" if link else ""))
        missing = [f for f in ("buying.md", "selling.md") if not os.path.isfile(os.path.join(d, f))]
        if missing:
            add("warn", "skill", "single-file skill (no %s): the rules come from SKILL.md's sections; link the repo's "
                "skill/willhaben instead" % ", ".join(missing))
        elif not link and os.path.isfile(SHIPPED_SKILL) and os.path.realpath(d) != os.path.dirname(SHIPPED_SKILL):
            with open(path, encoding="utf-8") as f1, open(SHIPPED_SKILL, encoding="utf-8") as f2:
                if f1.read() != f2.read():
                    add("info", "skill", "a copy that differs from the repo's; a symlink would follow git")
        if "Judging a deal" not in skill_rules("buy") or "Pricing advice" not in skill_rules("sell"):
            add("warn", "skill", "the buying or pricing rules are missing: deal/hunt/advise send less to Claude")

    add("ok", "templates", "%d built-in profiles, %d template%s" % (
        len(profiles.BUILTIN), len(profiles.TEMPLATES), "" if len(profiles.TEMPLATES) == 1 else "s"))
    for p, err in profiles.TEMPLATE_ERRORS.items():
        add("warn", "templates", "%s skipped: %s" % (short(p), err))

    if not os.path.exists(DB):
        add("info", "database", "%s doesn't exist yet; the first search creates it" % short(DB))
    else:
        try:
            c = sqlite3.connect("file:%s?mode=ro" % urllib.parse.quote(DB), uri=True, timeout=10)
            try:
                check = c.execute("pragma quick_check").fetchone()[0]
                ads = c.execute("select count(*) from ads").fetchone()[0]
                last = c.execute("select max(at) from runs").fetchone()[0]
            finally:
                c.close()
        except sqlite3.Error as e:
            add("FAIL", "database", "%s: %s" % (short(DB), e))
        else:
            add("ok" if check == "ok" else "FAIL", "database", "%s: %s, %d ads, %.1f MB, last search %s" % (
                short(DB), "intact" if check == "ok" else check, ads, os.path.getsize(DB) / 1e6, last or "never"))

    me, on_path = os.path.realpath(__file__), shutil.which("wh")
    if not on_path:
        add("warn", "tools", "wh is not on PATH: ln -sf %s ~/.local/bin/wh" % short(me))
    elif os.path.realpath(on_path) != me:
        add("warn", "tools", "`wh` on PATH is %s, not this one (%s)" % (short(os.path.realpath(on_path)), short(me)))
    add("ok" if shutil.which("claude") else "warn", "tools", "claude %s" % (
        "found" if shutil.which("claude") else "not found: deal/advise/hunt only work with --no-ai"))
    if not (shutil.which("magick") or shutil.which("convert")):
        add("info", "tools", "no ImageMagick: `wh photos` keeps WebP photos as they are")
    return out


def cmd_doctor(a):
    checks = doctor_checks()
    for level, what, msg in checks:
        print("%-5s %-10s %s" % (level, what, msg))
    if any(level == "FAIL" for level, *_ in checks):
        sys.exit(1)


def cmd_profiles(a):
    home = os.path.expanduser("~")
    for name in sorted(profiles.PROFILES):
        tpl = profiles.TEMPLATES.get(name)
        cat = profiles.CATEGORY.get(name)
        print("%-14s %-9s %-34s %s" % (name, "template" if tpl else "built-in",
                                       cell(", ".join(profiles.FIELDS.get(name, [])), 34), cat[1] if cat else ""))
        if tpl:
            if tpl["about"]:
                print("%25s%s" % ("", tpl["about"]))
            print("%25s%s" % ("", tpl["path"].replace(home, "~", 1)))
    if profiles.TEMPLATE_ERRORS:
        print("\nSkipped (broken):")
        for path, err in profiles.TEMPLATE_ERRORS.items():
            print("  %s: %s" % (path.replace(home, "~", 1), err))
    print("\nTemplates are read from: %s" % ", ".join(d.replace(home, "~", 1) for d in profiles.TEMPLATE_DIRS))


def main():
    ap = argparse.ArgumentParser(prog="wh", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search", help="search willhaben (keyword and/or category URL), store and list the ads")
    s.add_argument("words", nargs="*")
    s.add_argument("--url", help="willhaben search URL or category slug, e.g. computer-tablets/notebooks-5831")
    s.add_argument("--min", type=float)
    s.add_argument("--max", type=float)
    s.add_argument("--pages", type=int, default=3, help="pages of 200 ads (default 3)")
    s.add_argument("--limit", type=int, default=40)
    s.add_argument("--profile", choices=sorted(profiles.PROFILES))
    s.add_argument("--area", help="mark the ads in these states, e.g. wien,noe (nothing gets filtered out)")
    s.add_argument("--all", action="store_true", help="keep junk (defects, wanted ads, parts)")
    s.add_argument("--md", action="store_true", help="Markdown table")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_search)

    s = sub.add_parser("facets", help="willhaben's breakdown of a search: subcategories (with URLs), condition, "
                                      "region, brand … with counts; for writing a note's `search:` lines")
    s.add_argument("words", nargs="*")
    s.add_argument("--url", help="willhaben search URL or category slug")
    s.add_argument("--min", type=float)
    s.add_argument("--max", type=float)
    s.add_argument("--limit", type=int, default=15, help="values per filter (default 15)")
    s.set_defaults(fn=cmd_facets)

    s = sub.add_parser("profiles", help="the built-in profiles and the templates (templates/*.toml) a note's "
                                        "`wh-profile` or --profile can name, and any template that's broken")
    s.set_defaults(fn=cmd_profiles)

    s = sub.add_parser("doctor", help="check the config, notes, skill install, templates, database and tools "
                                      "(no request to willhaben)")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("ad", help="one ad in full (description, seller, price history)")
    s.add_argument("ad", help="ad ID or link")
    s.add_argument("--refresh", action="store_true")
    s.set_defaults(fn=cmd_ad)

    s = sub.add_parser("history", help="an ad's prices over time as wh saw them (database only, no request)")
    s.add_argument("ad", help="ad ID or link")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_history)

    s = sub.add_parser("photos", help="download an ad's photos as JPEG (WebP gets converted)")
    s.add_argument("ad")
    s.add_argument("dir")
    s.set_defaults(fn=cmd_photos)

    s = sub.add_parser("status", help="online? price? for every open note with an `ad:`; updates `checked`")
    s.add_argument("notes", nargs="*")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("sweep", help="run the `search:` of open buy/wanted notes; writes new ads, price cuts, "
                                     "gone ads and a shortlist into the note")
    s.add_argument("notes", nargs="*")
    s.add_argument("--pages", type=int, default=5)
    s.add_argument("--limit", type=int, default=30)
    s.add_argument("--dry-run", action="store_true", help="print the block instead of writing it; records no run")
    s.add_argument("--no-write", action="store_true", help="record the run but leave the notes alone (for a timer)")
    s.add_argument("--json", action="store_true", help="print new ads, price cuts, gone ads and the shortlist per "
                                                       "note as JSON (for scripts); notes are written as usual")
    s.set_defaults(fn=cmd_sweep)

    kinds = ", ".join(sorted(market.KINDS))
    s = sub.add_parser("find", help="the best deals for an item: ads clearly below their market value, e.g. "
                                    "wh find 2x16gb ddr4 3200, wh find tv 45-55 zoll")
    s.add_argument("words", nargs="*", help="what you're looking for, in plain words")
    s.add_argument("--kind", choices=sorted(market.KINDS), help="the kind of item if wh can't tell (%s)" % kinds)
    s.add_argument("--size", help="screen size range for tv/monitor, e.g. 45-55")
    s.add_argument("--min", type=float)
    s.add_argument("--max", type=float)
    s.add_argument("--below", type=float, default=0.15, help="show ads at least this far below value (default 0.15)")
    s.add_argument("--all", action="store_true", help="every matching ad, deal or not, best first")
    s.add_argument("--area", help="mark the ads in these states, e.g. wien,noe (nothing gets filtered out)")
    s.add_argument("--details", type=int, default=8, help="check the full ad of the top N (default 8)")
    s.add_argument("--limit", type=int, default=15)
    s.add_argument("--no-crawl", action="store_true", help="use the database as it is (no request)")
    s.add_argument("--md", action="store_true")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_find)

    s = sub.add_parser("value", help="what an item (words) or an ad (link or id) is worth on willhaben used")
    s.add_argument("words", nargs="+")
    s.add_argument("--kind", choices=sorted(market.KINDS))
    s.add_argument("--size")
    s.add_argument("--price", type=float, help="compare this price with the value")
    s.add_argument("--no-crawl", action="store_true")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_value)

    s = sub.add_parser("crawl", help="read whole willhaben categories into the database (the market values come "
                                     "from them): a full crawl once a day, then only the new ads")
    s.add_argument("kinds", nargs="*", help="kinds to crawl (default all: %s)" % kinds)
    s.add_argument("--full", action="store_true", help="every page, even if the last full crawl is recent")
    s.add_argument("--new", action="store_true", help="only the new ads, even if a full crawl is due")
    s.add_argument("--list", action="store_true", help="the categories, ads in the database and last full crawl")
    s.set_defaults(fn=cmd_crawl)

    s = sub.add_parser("watch", help="saved finds: `add NAME QUERY`, `list`, `rm NAME`, `run` (new deals once, "
                                     "--json for a timer)")
    s.add_argument("action", choices=("add", "list", "rm", "run"))
    s.add_argument("args", nargs="*")
    s.add_argument("--kind", choices=sorted(market.KINDS))
    s.add_argument("--size")
    s.add_argument("--min", type=float)
    s.add_argument("--max", type=float)
    s.add_argument("--below", type=float, default=0.25, help="report ads at least this far below value (default 0.25)")
    s.add_argument("--conf", choices=("low", "medium", "high"), default="medium")
    s.add_argument("--area")
    s.add_argument("--for", dest="for_", help="who it's for (default me)")
    s.add_argument("--details", type=int, default=5)
    s.add_argument("--no-crawl", action="store_true")
    s.add_argument("--dry-run", action="store_true", help="don't remember what was reported")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_watch)

    for name, fn, hlp in (("deal", cmd_deal, "AI: is this ad worth buying? verdict, comparables, offer, questions"),
                          ("advise", cmd_advise, "AI: should I change the price of my live ads?"),
                          ("hunt", cmd_hunt, "AI: sweep a buy note, then let Claude pick the best ads into it")):
        s = sub.add_parser(name, help=hlp)
        if name == "deal":
            s.add_argument("ad", help="ad ID or link")
            s.add_argument("--compare", help="keywords for the comparable ads (default: from the title)")
            s.add_argument("--question", help="an extra question for Claude")
            s.add_argument("--profile", choices=sorted(profiles.PROFILES))
            s.add_argument("--for", dest="for_", metavar="WHO",
                           help="who it's for (me, homelab, a friend, …); without it Claude is told not to assume")
        elif name == "advise":
            s.add_argument("notes", nargs="*")
        else:
            s.add_argument("note", help="note name or path")
            s.add_argument("--details", type=int, default=15, help="fetch full ads for the top N (default 15)")
            s.add_argument("--dry-run", action="store_true", help="don't write into the note")
        s.add_argument("--pages", type=int, default=5 if name == "hunt" else 2)
        s.add_argument("--limit", type=int, default=40 if name == "hunt" else 30)
        s.add_argument("--model", help="Claude model (default: Claude Code's; or WH_MODEL)")
        s.add_argument("--no-ai", action="store_true", help="print the data and task instead of asking Claude")
        s.add_argument("--timeout", type=int, default=600, help="seconds to wait for Claude (default 600)")
        s.set_defaults(fn=fn)

    a = ap.parse_args()
    if a.cmd not in ("profiles", "doctor"):
        for path in profiles.TEMPLATE_ERRORS:
            log("wh: skipped the broken template %s (see `wh profiles`)" % os.path.basename(path))
    try:
        a.fn(a)
    except WhError as e:
        sys.exit("wh: %s" % e)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
