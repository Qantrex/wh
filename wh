def db():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    c = sqlite3.connect(DB, timeout=30)
    c.row_factory = sqlite3.Row
    c.execute("pragma journal_mode=wal")
    c.executescript(SCHEMA)
    have = {r["name"] for r in c.execute("pragma table_info(ads)")}
    for name, typ in AD_COLUMNS:
        if name not in have:
            c.execute("alter table ads add column %s %s" % (name, typ))
    c.execute("create index if not exists ads_last_seen on ads (last_seen)")
    c.commit()
    return c


def summary(a):
    at = attrs(a)
    g = lambda n: (at.get(n) or [""])[0]  # noqa: E731
    seo = g("SEO_URL")
    return dict(id=int(a["id"]), title=g("HEADING") or a.get("description", ""), price=num(g("PRICE")),
                loc=g("LOCATION"), state=g("STATE"), postcode=g("POSTCODE"), private=int(g("ISPRIVATE") == "1"),
                published=g("PUBLISHED_String")[:10],
                url=(BASE + "/iad/" + seo.lstrip("/")) if seo else "%s/iad/object?adId=%s" % (BASE, a["id"]),
                body=clean(g("BODY_DYN")), cats=",".join(at.get("categorytreeids") or []),
                tattrs=g("categorytreeattributeids"), seller=g("ORGID") or None,
                p2p=int(g("p2penabled") == "true"), coords=g("COORDINATES") or None)


def store(c, ads, t):
    cols = ",".join(AD_FIELDS)
    for a in ads:
        a = dict({k: None for k in AD_FIELDS}, **a)
        old = c.execute("select price from ads where id=?", (a["id"],)).fetchone()
        if old is None:
            c.execute("insert into ads (%s, first_seen, last_seen) values (%s, :t, :t)"
                      % (cols, ",".join(":" + k for k in AD_FIELDS)), dict(a, t=t))
        else:
            c.execute("update ads set %s, last_seen=:t where id=:id"
                      % ", ".join("%s=:%s" % (k, k) for k in AD_FIELDS if k != "id"), dict(a, t=t))
        if old is None or old["price"] != a["price"]:
            c.execute("insert into prices values (?,?,?)", (a["id"], a["price"], t))


def read_page(url):
    """One search page as (rows_found, ad summaries), or None when the page has no search result."""
    _, h = fetch(url)
    sr = page_props(h).get("searchResult")
    if not sr:
        return None
    return sr.get("rowsFound") or 0, [summary(a) for a in (sr.get("advertSummaryList") or {}).get("advertSummary") or []]


def run_searches(c, jobs, pages=5, record=True):
    """Fetch [(url, key), …] through the worker pool, page 1 of every search first (it says how many pages there are),
    then the rest. Stores the ads and, unless record=False, one run per key. Returns one dict per job: ads, found,
    complete (every page read) and error (why not, when a page failed)."""
    t = now()
    urls = list(dict.fromkeys(u for u, _ in jobs))
    first = pmap(lambda u: read_page(u + "&page=1"), urls)
    more = [(u, p) for u, r in zip(urls, first) if isinstance(r, tuple) for p in range(2, min(pages, -(-r[0] // 200)) + 1)]
    rest = dict(zip(more, pmap(lambda job: read_page("%s&page=%d" % job), more)))
    res = {}
    for u, r in zip(urls, first):
        if not isinstance(r, tuple):
            res[u] = dict(ads=[], found=0, complete=False, error=str(r) if r else "page 1 has no search result")
            log("  %s: %s" % (describe(u), res[u]["error"]))
            continue
        found, ads, errors = r[0], {a["id"]: a for a in r[1]}, []
        needed = -(-found // 200)
        for p in range(2, min(pages, needed) + 1):
            rp = rest[(u, p)]
            if isinstance(rp, tuple) and rp[1]:
                ads.update((a["id"], a) for a in rp[1])
            else:
                errors.append("page %d: %s" % (p, rp if isinstance(rp, FetchError) else "no ads"))
        error = "; ".join(errors) or None
        res[u] = dict(ads=list(ads.values()), found=found, complete=not error and needed <= pages, error=error)
        log("  %s: %d of %d ads%s" % (describe(u), len(ads), found, " (%s)" % error if error else ""))
    for u in urls:
        store(c, res[u]["ads"], t)
    if record:
        for u, key in jobs:
            r = res[u]
            cur = c.execute("insert into runs (key, url, at, found, complete) values (?,?,?,?,?)",
                            (key or u, u, t, r["found"], int(r["complete"])))
            c.executemany("insert into hits values (?,?)", [(cur.lastrowid, a["id"]) for a in r["ads"]])
    c.commit()
    return [res[u] for u, _ in jobs]


def run_search(c, url, pages=5, key=None, record=True):
    """run_searches() for one search. Returns (ads, rows_found, complete)."""
    r = run_searches(c, [(url, key)], pages, record)[0]
    return r["ads"], r["found"], r["complete"]


def fetch_detail(i, prev):
    """The full ad page as a dict, without touching the database. A gone ad keeps what was known, as 'offline'."""
    final, h = fetch("%s/iad/object?adId=%d" % (BASE, i))
    if h and '<script id="__NEXT_DATA__"' not in h:            # an error or changed page, not a gone ad
        raise FetchError("no ad data on the page for ad %d (willhaben down, or its HTML changed?)" % i)
    ad = page_props(h).get("advertDetails") if h else None
    if not ad:
        d = dict(prev, id=i, status="offline", url=prev.get("url") or "%s/iad/object?adId=%d" % (BASE, i))
    else:
        at = attrs(ad)
        g = lambda n: (at.get(n) or [""])[0]  # noqa: E731
        seller = ad.get("sellerProfileUserData") or {}
        addr = ad.get("advertAddressDetails") or {}
        info = []
        for grp in ad.get("attributeInformation") or []:
            label = (grp.get("treeAttributeElement") or {}).get("label")
            vals = ", ".join(v.get("label", "") for v in grp.get("values") or [])
            if label and vals:
                info.append("%s: %s" % (label, vals))
        imgs = (ad.get("advertImageList") or {}).get("advertImage") or []
        d = dict(id=i, status=(ad.get("advertStatus") or {}).get("id", "?"), title=ad.get("description", ""),
                 price=num(g("PRICE")), old_price=num(g("OLD_PRICE")), price_cut_on=day(g("PRICE_REDUCTION_SET_DATE")),
                 loc=" ".join(x for x in (addr.get("postCode"), addr.get("postalName"), addr.get("province")) if x),
                 private=bool(seller.get("private", g("ISPRIVATE") == "1")), seller=seller.get("name"),
                 seller_since=(seller.get("registerDate") or "")[:7], seller_ads=seller.get("activeAdCount"),
                 first_published=day(ad.get("firstPublishedDate")), changed=day(ad.get("changedDate")),
                 ends=day(ad.get("endDate")), info=info, descr=clean(g("DESCRIPTION")),
                 images=[u for u in (x.get("referenceImageUrl") or x.get("mainImageUrl") for x in imgs) if u],
                 url=final if "/d/" in final else "%s/iad/object?adId=%d" % (BASE, i))
    return d


def save_detail(c, d, t):
    i = d["id"]
    if d["status"] != "offline" and d.get("price") is not None:
        last = c.execute("select price from prices where id=? order by seen desc, rowid desc limit 1", (i,)).fetchone()
        if last is None or last["price"] != d["price"]:
            c.execute("insert into prices values (?,?,?)", (i, d["price"], t))
        c.execute("update ads set price=?, last_seen=? where id=?", (d["price"], t, i))
    c.execute("insert or replace into details values (?,?,?)", (i, t, json.dumps(d, ensure_ascii=False)))


def details_many(c, ids, refresh=False):
    """details() for many ads: fresh ones from the cache, the rest fetched in parallel. {id: dict or FetchError}"""
    out, todo = {}, []
    for i in dict.fromkeys(ids):
        row = c.execute("select fetched, data from details where id=?", (i,)).fetchone()
        prev = json.loads(row["data"]) if row else {}
        if row and not refresh and hours_since(row["fetched"]) < DETAIL_MAX_AGE_H:
            out[i] = prev
        else:
            todo.append((i, prev))
    t = now()
    for (i, _), d in zip(todo, pmap(lambda job: fetch_detail(*job), todo)):
        if not isinstance(d, FetchError):
            save_detail(c, d, t)
        out[i] = d
    c.commit()
    return out


def details(c, i, refresh=False):
    """Full ad page as a dict (cached DETAIL_MAX_AGE_H hours). status is 'offline' when the ad is gone."""
    d = details_many(c, [i], refresh)[i]
    if isinstance(d, FetchError):
        raise d
    return d


def attach_details(c, ads):
    """Enrich ad summaries in-place with cached full descriptions/attributes from SQLite."""
    if not ads:
        return ads
    ids = [a["id"] for a in ads]
    cached = {}
    for i in range(0, len(ids), 500):
        chunk = ids[i:i + 500]
        q = "select id, data from details where id in (%s)" % ",".join("?" * len(chunk))
        cached.update({r["id"]: json.loads(r["data"]) for r in c.execute(q, chunk)})
    for a in ads:
        d = cached.get(a["id"])
        if d and d.get("descr"):
            a.setdefault("descr", d["descr"])
            a.setdefault("info", d.get("info") or [])
    return ads


def last_prices(c, ids, at):
    """{id: the last price recorded at or before `at`} for these ads (only their rows, not the whole table)."""
    out, ids = {}, sorted(ids)
    for k in range(0, len(ids), 500):
        chunk = ids[k:k + 500]
        for r in c.execute("select id, price from prices where id in (%s) and seen <= ? order by id, seen, rowid"
                           % ",".join("?" * len(chunk)), chunk + [at]):
            out[r["id"]] = r["price"]
    return out


def price_history(c, i):
    return [(r["seen"][:10], r["price"]) for r in c.execute("select price, seen from prices where id=? order by seen", (i,))]


