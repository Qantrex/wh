def cmd_photos(a):
    c = db()
    d = details(c, ad_id(a.ad), refresh=True)
    if not d.get("images"):
        sys.exit("wh: ad is offline, no cached photos" if d["status"] == "offline" else "wh: ad has no photos")
    os.makedirs(a.dir, exist_ok=True)
    for n, u in enumerate(d["images"], 1):
        _, raw = fetch(u, binary=True)
        if not raw:
            log("  photo %d unavailable: %s" % (n, u))
            continue
        webp = raw[:4] == b"RIFF" and raw[8:12] == b"WEBP"
        png = raw[:8] == b"\x89PNG\r\n\x1a\n"
        path = os.path.join(a.dir, "%d-%02d.%s" % (d["id"], n, "webp" if webp else "png" if png else "jpg"))
        with open(path, "wb") as f:
            f.write(raw)
        if webp:
            jpg = path[:-4] + "jpg"
            for tool in ("magick", "convert"):
                try:
                    if subprocess.run([tool, path, jpg], capture_output=True).returncode == 0:
                        os.remove(path)
                        path = jpg
                        break
                except FileNotFoundError:
                    continue
        print(path)


