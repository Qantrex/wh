def title_words(title):
    return [w for w in re.findall(r"[a-z0-9äöüß]+", title.lower()) if w not in STOP and (len(w) > 1 or w.isdigit())]


def comp_words(title):
    """A short keyword search for ads like this one: the first meaningful words of the title."""
    return " ".join(title_words(title)[:4])


def comparables(c, d, words, pages, profile, fetched=None):
    """Ads found by a keyword search (or `fetched`, its run_searches() result), minus this ad and junk.
    Returns (ads, 'N found, M removed …' line)."""
    if fetched is None:
        ads, found, _ = run_search(c, search_url(words), pages, key="comps:" + words)
    else:
        ads, found = fetched["ads"], fetched["found"]
    ads = profiles.annotate(attach_details(c, ads), profile)
    own = sum(1 for x in ads if x["id"] == d["id"])
    junk = sum(1 for x in ads if x["junk"] and x["id"] != d["id"])
    mine = set(title_words(d["title"]))
    ads = [x for x in ads if x["id"] != d["id"] and not x["junk"]]
    ads.sort(key=lambda x: (-len(mine & set(title_words(x["title"]))), x["price"]))   # most similar titles first
    note = "%d found%s%s; listed with the most similar titles first" % (
        found, ", the ad itself removed" if own else "",
        ", %d removed as junk (defects, wanted ads, no price)" % junk if junk else "")
    return ads, note


