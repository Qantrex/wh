def note_profile(props, path):
    """The note's `wh-profile` if wh knows it (built-in or template); otherwise say so and use none."""
    name = props.get("wh-profile") or None
    if name and name not in profiles.PROFILES:
        log("wh: %s: unknown wh-profile '%s' (known: %s); sweeping without one"
            % (name_of(path), name, ", ".join(sorted(profiles.PROFILES))))
        return None
    return name


def sweep_plan(c, path, props):
    """A note's searches and what earlier sweeps saw, read before this run records anything."""
    searches = props.get("search") or []
    searches = searches if isinstance(searches, list) else [searches]
    items = []
    for s in searches:
        is_url = s.startswith("http") or "/" in s or re.fullmatch(r"[a-z0-9-]+-\d{3,}", s)
        url = search_url(url=s) if is_url else search_url(s)
        key = "note:%s:%s" % (name_of(path), url)
        last = c.execute("select run, at from runs where key=? order by run desc limit 1", (key,)).fetchone()
        full = c.execute("select run from runs where key=? and complete=1 order by run desc limit 1", (key,)).fetchone()
        seen = {r["id"] for r in c.execute("select distinct h.id from hits h join runs r on r.run=h.run"
                                           " where r.key=?", (key,))}
        items.append(dict(search=s, url=url, key=key, last=last, full=full, seen=seen))
    ats = [x["last"]["at"] for x in items if x["last"]]
    seen = set().union(*(x["seen"] for x in items))
    return dict(items=items, prev_prices=last_prices(c, seen, max(ats)) if ats else {}, seen=seen,
                profile=note_profile(props, path), near=area(props.get("wh-area")))


def category_notes(plan, fetched):
    """Searches whose ads mostly sit outside the profile's willhaben category: pages fetched only to be dropped."""
    cat = profiles.CATEGORY.get(plan["profile"])
    out = []
    for x, r in zip(plan["items"], fetched if cat else []):
        with_cats = [a for a in r["ads"] if a.get("cats")]
        off = sum(1 for a in with_cats if not re.search(r"\b%s\b" % cat[0], a["cats"]))
        if len(with_cats) >= 20 and off > 0.3 * len(with_cats):
            out.append("%s: %d%% of its ads are outside willhaben's %s category and get dropped; search %s instead"
                       % (x["search"], 100 * off // len(with_cats), cat[1].rsplit("/", 1)[-1],
                          in_category(x["url"], cat[1])))
    return out


def sweep_report(c, plan, fetched, limit, detail_count=0):
    """The sweep block from this run's results (one run_searches() dict per search of the plan).
    Returns (markdown block, shortlist, all good ads, market line)."""
    profile = plan["profile"]
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    allads, new_ids, gone_ids, notes = {}, set(), set(), []
    for x, r in zip(plan["items"], fetched):
        if r["error"]:
            notes.append("%s: couldn't read it all (%s)" % (x["search"], r["error"]))
        elif not r["complete"]:
            notes.append("%s: read %d of %d ads (raise --pages for all)" % (x["search"], len(r["ads"]), r["found"]))
        for a in r["ads"]:
            allads[a["id"]] = a
        ids = {a["id"] for a in r["ads"]}
        if x["last"]:
            new_ids |= ids - plan["seen"]
        if x["full"] and r["complete"]:                     # gone: against the last sweep that read every page
            gone_ids |= {row["id"] for row in c.execute("select id from hits where run=?", (x["full"]["run"],))} - ids
    notes += category_notes(plan, fetched)
    vals = profiles.annotate(attach_details(c, list(allads.values())), profile)
    good = [x for x in vals if not x["junk"]]
    short = profiles.shortlist(good, profile, limit)
    if detail_count > 0:
        top = short[:detail_count]                          # full descriptions for the top of every shortlist bucket
        got = details_many(c, [x["id"] for x in top])
        closed = {}
        for x in top:
            d = got[x["id"]]
            if isinstance(d, FetchError):
                continue
            if d["status"] in ("offline", "sold", "deleted", "inactive"):
                closed[x["id"]] = d["status"]
                continue
            x["descr"] = d["descr"]
            x["info"] = d.get("info") or []
            x["ad_status"] = d.get("status")
            x["old_price"] = d.get("old_price")
            x["seller"] = "%s, member since %s, %s active ads" % (
                d.get("seller"), d.get("seller_since"), d.get("seller_ads"))
            x["first_published"] = d.get("first_published")
        profiles.annotate(vals, profile)
        for x in vals:
            if x["id"] in closed:
                x["junk"] = closed[x["id"]]
        good = [x for x in vals if not x["junk"]]
        short = profiles.shortlist(good, profile, limit)
    mark_near(vals, plan["near"])
    prev_prices = plan["prev_prices"]
    new = sorted((x for x in good if x["id"] in new_ids), key=lambda x: x["price"])
    cuts = sorted((x for x in good if x["id"] in plan["seen"] and prev_prices.get(x["id"])
                   and x["price"] < prev_prices[x["id"]]), key=lambda x: x["price"])
    gone_rows = [dict(r) for i in sorted(gone_ids - set(allads))
                 for r in [c.execute("select * from ads where id=?", (i,)).fetchone()] if r]
    gone = [g for g in profiles.annotate(attach_details(c, gone_rows), profile) if not g["junk"]]
    mk = market(good)
    near = (" · %d in %s" % (sum(1 for x in good if x["near"]), area_label(plan["near"]))) if plan["near"] else ""
    n = len(plan["items"])
    out = ["## Sweep", "", "*wh sweep %s · %d search%s · %s%s · %d new · %d price cuts · %d gone*"
           % (stamp, n, "es" if n != 1 else "", mk, near, len(new), len(cuts), len(gone))]
    if notes:
        out += [""] + ["> " + x for x in notes]
    if new:
        out += ["", "### New since last sweep", "", table(new[:limit], profile, True)]
    if cuts:
        out += ["", "### Price cuts", "", table(cuts[:limit], profile, True,
                                                 extra=lambda x: euro(prev_prices.get(x["id"])))]
    if gone:
        out += ["", "### Gone since last sweep", "", "Usually just expired, not sold."]
        out += ["- [%s](%s), %s" % (link_text(g["title"], 70), g["url"], euro(g["price"])) for g in gone[:limit]]
    out += ["", "### Shortlist", "", table(short, profile, True) if short else "Nothing matches."]
    return "\n".join(out), short, good, mk


def sweep_note(c, path, props, pages, limit, detail_count=0, record=True):
    """Run a note's searches; returns (markdown block, shortlist, all good ads, market line). record=False (dry runs)
    leaves no run behind, so the next real sweep still compares with the last real one."""
    plan = sweep_plan(c, path, props)
    fetched = run_searches(c, [(x["url"], x["key"]) for x in plan["items"]], pages, record)
    return sweep_report(c, plan, fetched, limit, detail_count)


def cmd_sweep(a):
    c = db()
    todo = [(f, t, p) for f, t, p in find_notes(a.notes, types={"buy", "wanted"}, statuses=OPEN) if p.get("search")]
    if not todo:
        sys.exit("wh: no open buy/wanted note with a `search:` property")
    for f, _, p in todo:
        note_for(p, f)
    plans = [sweep_plan(c, f, p) for f, _, p in todo]       # before this run records anything
    jobs = [(x["url"], x["key"]) for plan in plans for x in plan["items"]]
    log("%d notes, %d searches:" % (len(todo), len(jobs)))
    fetched = iter(run_searches(c, jobs, a.pages, record=not a.dry_run))   # one queue for every note
    for (f, text, p), plan in zip(todo, plans):
        block, short, good, mk = sweep_report(c, plan, [next(fetched) for _ in plan["items"]], a.limit)
        if a.dry_run:
            print(block)
            continue
        write_note(f, set_prop(put_block(text, "sweep", block), "checked", date.today().isoformat()))
        print("%s: %s; %d on the shortlist" % (name_of(f), mk, len(short)))
        for line in block.splitlines():
            if line.startswith("> "):
                print("  " + line[2:])


def cmd_deal(a):
    c = db()
    d = details(c, ad_id(a.ad), refresh=True)
    if d["status"] == "offline":
        sys.exit(fmt_details(d))
    words = a.compare or comp_words(d["title"])
    comps, found = comparables(c, d, words, a.pages, a.profile)
    data = who_block(a.for_) + "\n\n## The ad\n\n%s\n\n## Comparable ads on willhaben now\n\nSearch \"%s\": %s; %s. Some may not be " \
           "truly comparable: judge from the titles.\n\n%s" % (fmt_details(d, c), words, found, market(comps),
                                                              table(comps[:a.limit], a.profile, True))
    task = ("Should I buy this ad? Start with one verdict line: **good deal / fair / overpriced / walk away / likely "
            "scam**. Then: where the price sits against the comparable ads (with numbers), the total cost, anything in "
            "the ad that doesn't match its title, red flags, a suggested offer in €, and the questions to ask the seller "
            "first.")
    if a.question:
        task += "\nAlso answer: " + a.question
    ans = ask_claude(a, task, data, "buy")
    if ans:
        print(ans)


def cmd_advise(a):
    c = db()
    todo = [(f, t, p) for f, t, p in find_notes(a.notes, types={"sell"}, statuses=OPEN | {"draft"}) if p.get("ad")]
    if not todo:
        sys.exit("wh: no live sell note with an `ad:` property")
    ids = note_ads(todo)
    got = details_many(c, [i for i in ids if isinstance(i, int)], refresh=True)
    live = []
    for (f, text, p), i in zip(todo, ids):
        d = got.get(i, i)
        if isinstance(d, WhError):
            print("## %s\n\nwh: %s\n" % (name_of(f), d))
        elif d["status"] == "offline":
            print("## %s\n\nThe ad is offline (usually just expired): renew or relist it.\n" % name_of(f))
        else:
            live.append((f, text, p, d, p.get("wh-compare") or comp_words(d["title"])))
    found_all = run_searches(c, [(search_url(w), "comps:" + w) for *_, w in live], a.pages)  # all at once
    task = ("This is one of my own ads. Should I change the price? Give one concrete answer first (\"keep €X\" or "
            "\"lower to €X\"), then why: days online, views and watchers over time from my note's Checks table, "
            "offers so far, and the truly comparable ads. If few people look at it, say what to change instead "
            "(title, photos, category). No paid extras.")
    jobs = []
    for (f, text, p, d, words), r in zip(live, found_all):
        profile = note_profile(p, f)
        comps, found = comparables(c, d, words, a.pages, profile, fetched=r)
        data = ("## My note\n\n%s\n\n## My ad now\n\n%s\n\n## Comparable ads on willhaben now\n\nSearch \"%s\": %s; "
                "%s.\n\n%s" % (strip_blocks(text), fmt_details(d, c), words, found, market(comps),
                               table(comps[:a.limit], profile, True)))
        jobs.append((task, data, "sell"))
    if a.no_ai:
        for (f, *_), job in zip(live, jobs):
            if len(live) > 1:
                print("# %s\n" % name_of(f))
            ask_claude(a, *job)
        return
    for (f, *_), ans in zip(live, ask_all(a, jobs)):            # one Claude call per ad, all at the same time
        print("## %s\n\n%s\n" % (name_of(f), ans))


def cmd_hunt(a):
    c = db()
    todo = find_notes([a.note], types={"buy", "wanted"})
    if not todo:
        sys.exit("wh: %s is not a buy/wanted note" % a.note)
    f, text, p = todo[0]
    if not p.get("search"):
        sys.exit("wh: %s has no `search:` property" % name_of(f))
    block, short, good, mk = sweep_note(c, f, p, a.pages, a.limit, detail_count=a.details, record=not a.dry_run)
    if not a.dry_run:                                       # saved now, so a failed Claude call doesn't lose the sweep
        text = set_prop(put_block(text, "sweep", block), "checked", date.today().isoformat())
        write_note(f, text)
    profile = note_profile(p, f)
    who = note_for(p, f)
    states = area(p.get("wh-area"))
    rows = []
    for x in short:
        if x.get("junk"):
            continue
        meta = ["private" if x["private"] else "dealer"]
        if states:
            meta.append("near me" if x.get("near") else "outside my area (travel or shipping)")
        if x.get("ad_status") and x["ad_status"] != "active":
            meta.append("STATUS: " + x["ad_status"])
        if x.get("old_price"):
            meta.append("cut from " + euro(x["old_price"]))
        sp = specs(x, profile)
        if sp:
            meta.append(sp)
        meta.append("online since %s" % (x.get("first_published") or x.get("published")))
        if x.get("seller"):
            meta.append("seller " + x["seller"])
        if x.get("info"):
            meta.append("; ".join(x["info"]))
        rows.append("- **%s** %s · %s · %s\n  %s\n  %s" % (
            euro(x["price"]), x["title"], x["loc"], " · ".join(meta),
            x["url"], cell(x.get("descr") or x.get("body"), 2000)))
    if not rows:
        print("Nothing matches.")
        return
    where = ("\n\n## Where\n\nMy pickup area is %s. Ads outside it are still options (I can travel there or ask for "
             "shipping): weigh the distance, but don't drop a good deal for it." % area_label(states)) if states else ""
    data = "%s\n\n## The buy note\n\n%s\n\n## Market\n\n%s (after removing junk)%s\n\n## Shortlist\n\n%s" % (
        who_block(who), strip_blocks(text), mk, where, "\n".join(rows))
    task = ("Pick the best options from the shortlist for what the buy note asks for, for the person or purpose it's "
            "for. Answer with exactly two sections. "
            "`## Picks`: the ads you'd actually recommend, best first, as a numbered list. For each: price and link, why "
            "it's good value against the market, what to check or ask the seller, and a suggested offer. `## Warnings`: "
            "ads that look like scams or too good to be true, one line each with the link and why.")
    ans = ask_claude(a, task, data, "buy")
    if ans is None:
        return
    parts = re.split(r"^#{2,3}\s+Warnings\b[^\n]*\n?", ans, maxsplit=1, flags=re.M | re.I)
    picks, warnings = parts[0], parts[1] if len(parts) > 1 else ""
    picks = re.sub(r"\A.*?^#{2,3}\s+Picks\b[^\n]*\n?", "", picks, count=1, flags=re.M | re.S | re.I).strip()
    out = "## Picks\n\n*wh hunt %s (Claude)*\n\n%s" % (datetime.now().strftime("%Y-%m-%d %H:%M"), picks)
    if not a.dry_run:
        write_note(f, put_block(text, "picks", out))
    print(out)
    if warnings.strip():
        print("\n## Warnings (not written to the note)\n\n" + warnings.strip())


def cmd_facets(a):
    """willhaben's own breakdown of a search (its filter sidebar): subcategories with ready-to-paste URLs, and the
    other filters (condition, region, brand, …) as URL parameters, each with its number of ads."""
    url = search_url(" ".join(a.words) or None, a.url, a.min, a.max)
    _, h = fetch(url + "&page=1")
    sr = page_props(h).get("searchResult")
    if not sr:
        raise WhError("no search result for %s" % url)
    print("%d ads for %s" % (sr.get("rowsFound") or 0, url.replace("&rows=200", "").replace("?rows=200", "")))
    for g in sr.get("navigatorGroups") or []:
        for n in g.get("navigatorList") or []:
            vals = [v for gv in n.get("groupedPossibleValues") or [] for v in gv.get("possibleValues") or []
                    if v.get("hits")]
            par = [(v.get("urlParamRepresentationForValue") or [{}])[0] for v in vals]
            if not vals or all(str(x.get("navigatorUrlParameterType", "")).startswith("RANGE") for x in par):
                continue
            print("\n%s" % n.get("label"))
            for v, x in list(zip(vals, par))[:a.limit]:
                link = (v.get("webLink") or {}).get("uri") if n.get("id") == "category" else None
                print("  %6s  %-34s %s" % (v["hits"], cell(v.get("label"), 34),
                                           link or "%s=%s" % (x.get("urlParameterName"), x.get("value"))))
            if len(vals) > a.limit:
                print("          … %d more" % (len(vals) - a.limit))


def cmd_profiles(a):
    home = os.path.expanduser("~")
    for name in sorted(profiles.PROFILES):
        tpl = profiles.TEMPLATES.get(name)
        cat = profiles.CATEGORY.get(name)
        print("%-14s %-9s %-34s %s" % (name, "template" if tpl else "built-in",
                                       cell(", ".join(profiles.FIELDS.get(name, [])), 34), cat[1] if cat else ""))
        if tpl:
            if tpl["about"]:
                print("%25s%s" % ("", tpl["about"]))
            print("%25s%s" % ("", tpl["path"].replace(home, "~", 1)))
    if profiles.TEMPLATE_ERRORS:
        print("\nSkipped (broken):")
        for path, err in profiles.TEMPLATE_ERRORS.items():
            print("  %s: %s" % (path.replace(home, "~", 1), err))
    print("\nTemplates are read from: %s" % ", ".join(d.replace(home, "~", 1) for d in profiles.TEMPLATE_DIRS))


def main():
    ap = argparse.ArgumentParser(prog="wh", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search", help="search willhaben (keyword and/or category URL), store and list the ads")
    s.add_argument("words", nargs="*")
    s.add_argument("--url", help="willhaben search URL or category slug, e.g. computer-tablets/notebooks-5831")
    s.add_argument("--min", type=float)
    s.add_argument("--max", type=float)
    s.add_argument("--pages", type=int, default=3, help="pages of 200 ads (default 3)")
    s.add_argument("--limit", type=int, default=40)
    s.add_argument("--profile", choices=sorted(profiles.PROFILES))
    s.add_argument("--area", help="mark the ads in these states, e.g. wien,noe (nothing gets filtered out)")
    s.add_argument("--all", action="store_true", help="keep junk (defects, wanted ads, parts)")
    s.add_argument("--md", action="store_true", help="Markdown table")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_search)

    s = sub.add_parser("facets", help="willhaben's breakdown of a search: subcategories (with URLs), condition, "
                                      "region, brand … with counts; for writing a note's `search:` lines")
    s.add_argument("words", nargs="*")
    s.add_argument("--url", help="willhaben search URL or category slug")
    s.add_argument("--min", type=float)
    s.add_argument("--max", type=float)
    s.add_argument("--limit", type=int, default=15, help="values per filter (default 15)")
    s.set_defaults(fn=cmd_facets)

    s = sub.add_parser("profiles", help="the built-in profiles and the templates (templates/*.toml) a note's "
                                        "`wh-profile` or --profile can name, and any template that's broken")
    s.set_defaults(fn=cmd_profiles)

    s = sub.add_parser("ad", help="one ad in full (description, seller, price history)")
    s.add_argument("ad", help="ad ID or link")
    s.add_argument("--refresh", action="store_true")
    s.set_defaults(fn=cmd_ad)

    s = sub.add_parser("photos", help="download an ad's photos as JPEG (WebP gets converted)")
    s.add_argument("ad")
    s.add_argument("dir")
    s.set_defaults(fn=cmd_photos)

    s = sub.add_parser("status", help="online? price? for every open note with an `ad:`; updates `checked`")
    s.add_argument("notes", nargs="*")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("sweep", help="run the `search:` of open buy/wanted notes; writes new ads, price cuts, "
                                     "gone ads and a shortlist into the note")
    s.add_argument("notes", nargs="*")
    s.add_argument("--pages", type=int, default=5)
    s.add_argument("--limit", type=int, default=30)
    s.add_argument("--dry-run", action="store_true", help="print the block instead of writing it")
    s.set_defaults(fn=cmd_sweep)

    for name, fn, hlp in (("deal", cmd_deal, "AI: is this ad worth buying? verdict, comparables, offer, questions"),
                          ("advise", cmd_advise, "AI: should I change the price of my live ads?"),
                          ("hunt", cmd_hunt, "AI: sweep a buy note, then let Claude pick the best ads into it")):
        s = sub.add_parser(name, help=hlp)
        if name == "deal":
            s.add_argument("ad", help="ad ID or link")
            s.add_argument("--compare", help="keywords for the comparable ads (default: from the title)")
            s.add_argument("--question", help="an extra question for Claude")
            s.add_argument("--profile", choices=sorted(profiles.PROFILES))
            s.add_argument("--for", dest="for_", metavar="WHO",
                           help="who it's for (me, homelab, a friend, …); without it Claude is told not to assume")
        elif name == "advise":
            s.add_argument("notes", nargs="*")
        else:
            s.add_argument("note", help="note name or path")
            s.add_argument("--details", type=int, default=15, help="fetch full ads for the top N (default 15)")
            s.add_argument("--dry-run", action="store_true", help="don't write into the note")
        s.add_argument("--pages", type=int, default=5 if name == "hunt" else 2)
        s.add_argument("--limit", type=int, default=40 if name == "hunt" else 30)
        s.add_argument("--model", help="Claude model (default: Claude Code's; or WH_MODEL)")
        s.add_argument("--no-ai", action="store_true", help="print the data and task instead of asking Claude")
        s.add_argument("--timeout", type=int, default=600, help="seconds to wait for Claude (default 600)")
        s.set_defaults(fn=fn)

    a = ap.parse_args()
    if a.cmd != "profiles":
        for path in profiles.TEMPLATE_ERRORS:
            log("wh: skipped the broken template %s (see `wh profiles`)" % os.path.basename(path))
    try:
        a.fn(a)
    except WhError as e:
        sys.exit("wh: %s" % e)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
