def sweep_note(c, path, props, pages, limit, detail_count=0):
    """Run a note's searches; returns (markdown block, shortlist, all good ads, market line)."""
    searches = props.get("search") or []
    searches = searches if isinstance(searches, list) else [searches]
    profile = props.get("wh-profile") or None
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    plan = []
    for s in searches:
        is_url = s.startswith("http") or "/" in s or re.fullmatch(r"[a-z0-9-]+-\d{3,}", s)
        url = search_url(url=s) if is_url else search_url(s)
        key = "note:%s:%s" % (name_of(path), url)
        prev = c.execute("select run, at, complete from runs where key=? order by run desc limit 1", (key,)).fetchone()
        seen = {r["id"] for r in c.execute("select distinct h.id from hits h join runs r on r.run=h.run"
                                           " where r.key=?", (key,))}
        plan.append((s, url, key, prev, seen))
    prev_ats = [prev["at"] for _, _, _, prev, _ in plan if prev]
    prev_prices = ({r["id"]: r["price"] for r in c.execute(
        "select id, price from prices where seen <= ? order by seen, rowid", (max(prev_ats),))} if prev_ats else {})
    seen_before = set().union(*(seen for *_, seen in plan)) if plan else set()
    allads, new_ids, gone_ids, notes = {}, set(), set(), []
    for s, url, key, prev, _ in plan:
        ads, found, complete = run_search(c, url, pages, key)
        if not complete:
            notes.append("%s: read %d of %d ads (raise --pages for all)" % (s, len(ads), found))
        for x in ads:
            allads[x["id"]] = x
        ids = {x["id"] for x in ads}
        if prev:
            new_ids |= (ids - seen_before)
            if prev["complete"] and complete:
                prev_ids = {r["id"] for r in c.execute("select id from hits where run=?", (prev["run"],))}
                gone_ids |= (prev_ids - ids)
    vals = profiles.annotate(attach_details(c, list(allads.values())), profile)
    good = [x for x in vals if not x["junk"]]
    short = profiles.shortlist(good, profile, limit)
    if detail_count > 0:
        closed = {}
        for x in short[:detail_count]:                      # full descriptions for the top of every shortlist bucket
            d = details(c, x["id"])
            if d["status"] in ("offline", "sold", "deleted", "inactive"):
                closed[x["id"]] = d["status"]
                continue
            x["descr"] = d["descr"]
            x["info"] = d.get("info") or []
            x["ad_status"] = d.get("status")
            x["old_price"] = d.get("old_price")
            x["seller"] = "%s, member since %s, %s active ads" % (
                d.get("seller"), d.get("seller_since"), d.get("seller_ads"))
            x["first_published"] = d.get("first_published")
        profiles.annotate(vals, profile)
        for x in vals:
            if x["id"] in closed:
                x["junk"] = closed[x["id"]]
        good = [x for x in vals if not x["junk"]]
        short = profiles.shortlist(good, profile, limit)
    new = sorted((x for x in good if x["id"] in new_ids), key=lambda x: x["price"])
    cuts = sorted((x for x in good if x["id"] in seen_before and prev_prices.get(x["id"])
                   and x["price"] < prev_prices[x["id"]]), key=lambda x: x["price"])
    gone_rows = [dict(r) for i in sorted(gone_ids - set(allads))
                 for r in [c.execute("select * from ads where id=?", (i,)).fetchone()] if r]
    gone = [g for g in profiles.annotate(attach_details(c, gone_rows), profile) if not g["junk"]]
    mk = market(good)
    out = ["## Sweep", "", "*wh sweep %s · %d search%s · %s · %d new · %d price cuts · %d gone*"
           % (stamp, len(searches), "es" if len(searches) != 1 else "", mk, len(new), len(cuts), len(gone))]
    if notes:
        out += [""] + ["> " + n for n in notes]
    if new:
        out += ["", "### New since last sweep", "", table(new[:limit], profile, True)]
    if cuts:
        out += ["", "### Price cuts", "", table(cuts[:limit], profile, True,
                                                 extra=lambda x: euro(prev_prices.get(x["id"])))]
    if gone:
        out += ["", "### Gone since last sweep", "", "Usually just expired, not sold."]
        out += ["- [%s](%s), %s" % (link_text(g["title"], 70), g["url"], euro(g["price"])) for g in gone[:limit]]
    out += ["", "### Shortlist", "", table(short, profile, True) if short else "Nothing matches."]
    return "\n".join(out), short, good, mk


def cmd_sweep(a):
    c = db()
    todo = [(f, t, p) for f, t, p in find_notes(a.notes, types={"buy", "wanted"}, statuses=OPEN) if p.get("search")]
    if not todo:
