class WhError(Exception):
    """Something to report as `wh: …`; commands that handle several notes report it per note and carry on."""


class FetchError(WhError):
    pass


def log(*a):
    print(*a, file=sys.stderr)


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def hours_since(ts):
    return (datetime.now(timezone.utc) - datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)).total_seconds() / 3600


# ---- fetching -------------------------------------------------------------------------------------------------

def wait_turn():
    """Block until this thread may send a request: RATE per second overall, or one per DELAY s once slowed down."""
    with _lock:
        gap = DELAY if _slow[0] else (1 / RATE if RATE > 0 else 0)
        t = max(time.monotonic(), _next[0])
        _next[0] = t + gap
    time.sleep(max(t - time.monotonic(), 0))


def slow_down(why):
    """willhaben pushed back: every worker drops to one request per DELAY s for the rest of the run."""
    with _lock:
        if not _slow[0]:
            log("  willhaben pushed back (%s): one request every %.1f s from now on" % (why, DELAY))
        _slow[0] = True
        _next[0] = max(_next[0], time.monotonic() + 5)


def fetch(url, binary=False):
    """GET with a browser UA within the shared rate limit, 3 tries. Returns (final_url, body); body is empty on a 404.
    Raises FetchError when every try fails."""
    err = None
    for attempt in range(3):
        if attempt:
            time.sleep(4 * attempt)
        wait_turn()
        try:
            req = urllib.request.Request(url, headers={
                "User-Agent": UA, "Accept-Language": "de-AT,de;q=0.9", "Accept-Encoding": "gzip",
            })
            with urllib.request.urlopen(req, timeout=30) as r:
                body = r.read()
                if body and r.headers.get("Content-Encoding", "").lower() == "gzip":
                    body = gzip.decompress(body)
                if binary:
                    return r.geturl(), body
                text = body.decode("utf-8", "replace")
                if not (r.headers.get("cf-mitigated") or "<title>Just a moment" in text[:3000]):
                    return r.geturl(), text
                err = "Cloudflare challenge"
                slow_down(err)
        except urllib.error.HTTPError as e:
            if e.code in (404, 410):
                return url, b"" if binary else ""
            if e.code in (403, 429, 503):
                slow_down("HTTP %d" % e.code)
            err = e
        except (http.client.HTTPException, OSError, EOFError, zlib.error) as e:   # EOFError: a cut-off gzip body
            err = e
        if attempt < 2:
            log("  retry %d: %s" % (attempt + 1, err))
    raise FetchError("can't fetch %s: %s" % (url, err))


def pmap(fn, items):
    """[fn(x) for x in items] on up to WORKERS threads, in order. A FetchError comes back in place of its result."""
    def one(x):
        try:
            return fn(x)
        except FetchError as e:
            return e
    if WORKERS == 1 or len(items) < 2:
        return [one(x) for x in items]
    ex = ThreadPoolExecutor(min(WORKERS, len(items)))
    try:
        return list(ex.map(one, items))
    finally:
        ex.shutdown(wait=False, cancel_futures=True)


def page_props(h):
    """The page's __NEXT_DATA__ pageProps, {} when it has none. Broken JSON raises FetchError instead of a traceback."""
    i = h.find('<script id="__NEXT_DATA__"')
    j = h.find("</script>", i) if i >= 0 else -1
    if j < 0:
        return {}
    try:
        props = json.loads(h[h.index(">", i) + 1:j])["props"]["pageProps"]
    except (ValueError, KeyError, TypeError) as e:
        raise FetchError("can't read willhaben's page data (%s: %s); did the site change?" % (type(e).__name__, e))
    return props if isinstance(props, dict) else {}


def attrs(obj):
    return {x["name"]: x.get("values") or [""] for x in obj["attributes"]["attribute"]}


def clean(s):
    s = re.sub(r"<br\s*/?>|</p>|</li>", "\n", s or "")
    s = html.unescape(re.sub(r"<[^>]+>", "", s))
    return re.sub(r"\n\s*\n+", "\n", re.sub(r"[ \t]+", " ", s)).strip()


def num(s):
    try:
        return float(str(s).replace(",", "."))
    except (TypeError, ValueError):
        return None


def day(v):
    """YYYY-MM-DD in Austria from an ISO date or time or a Unix timestamp (seconds or milliseconds). A time in UTC
    just before midnight is already the next day in Vienna."""
    v = str(v or "").strip()
    if v.isdigit():
        n = int(v)
        dt = datetime.fromtimestamp(n / 1000 if n > 1e11 else n, timezone.utc)
    else:
        try:
            dt = datetime.fromisoformat(v.replace("Z", "+00:00"))
        except ValueError:
            return v[:10]
        if dt.tzinfo is None:
            return dt.date().isoformat()
    return dt.astimezone(TZ).date().isoformat()


def ad_id(s):
    s = str(s)
    m = re.search(r"adId=(\d+)", s) or re.search(r"-(\d{6,})/?(?:[?#]|$)", s) or re.fullmatch(r"\s*(\d{6,})\s*", s)
    if not m:
        raise WhError("no willhaben ad id in %r" % s)
    return int(m.group(1))


def note_ads(todo):
    """The `ad:` id of every (path, text, props) note, or the WhError that says why it has none."""
    out = []
    for _, _, p in todo:
        try:
            out.append(ad_id(p["ad"]))
        except WhError as e:
            out.append(e)
    return out


def search_url(words=None, url=None, pmin=None, pmax=None, rows=200):
    """A search URL with `rows` per page and no page. `url` may be a full willhaben search URL or a category slug."""
    if url and not url.startswith("http"):
        url = SEARCH + "/" + url.strip("/")
    u = urllib.parse.urlsplit(url or SEARCH)
    drop = {"page", "rows"} | ({"keyword"} if words else set()) | ({"PRICE_FROM"} if pmin is not None else set()) | (
        {"PRICE_TO"} if pmax is not None else set())
    qs = [(k, v) for k, v in urllib.parse.parse_qsl(u.query) if k not in drop]
    if words:
        qs.append(("keyword", words))
    if pmin is not None:
        qs.append(("PRICE_FROM", str(int(pmin))))
    if pmax is not None:
        qs.append(("PRICE_TO", str(int(pmax))))
    qs.append(("rows", str(rows)))
    return urllib.parse.urlunsplit((u.scheme, u.netloc, u.path, urllib.parse.urlencode(qs), ""))


def in_category(url, path):
    """The same search inside another category, e.g. path 'computer-tablets/notebooks-5831'."""
    u = urllib.parse.urlsplit(url)
    qs = [(k, v) for k, v in urllib.parse.parse_qsl(u.query) if k not in ("rows", "page")]
    return urllib.parse.urlunsplit(("https", "www.willhaben.at", "/iad/kaufen-und-verkaufen/marktplatz/" + path,
                                    urllib.parse.urlencode(qs), ""))


def describe(url):
    """A search URL in a few words for the terminal: category and query."""
    u = urllib.parse.urlsplit(url)
    qs = "&".join("%s=%s" % kv for kv in urllib.parse.parse_qsl(u.query) if kv[0] not in ("rows", "page"))
    return (u.path.rsplit("/", 1)[-1] + ("?" + qs if qs else ""))[:90]


