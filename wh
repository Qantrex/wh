    head = dict(query=query, kind=name, wants=market.label(name, want) or "any", size=size,
                market=dict(value=own["value"], p25=own["p25"], p75=own["p75"], n=own["n"], conf=own["conf"],
                            key=" · ".join(str(x) for x in own["key"] if x != "-")) if own else None,
                matching=len(cands), valued=sum(1 for r in cands if r["score"] is not None))
    if a.json:
        print(json.dumps(dict(head, deals=[deal_json(r, name) for r in shown]), ensure_ascii=False, indent=1))
        return
    print("%s → %s: %s%s" % (query or "(everything)", name, head["wants"],
                             " · %d–%d\"" % size if size else ""))
